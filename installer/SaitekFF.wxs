<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI installer for the Saitek Cyborg force feedback driver. Build with package.ps1 (WiX 5 from dotnet-tools.json):
    wix build installer\SaitekFF.wxs -arch x64 -ext WixToolset.UI.wixext -d Version=2.0.0 -d BinDir=bin -o SaitekFF.msi
  The DLLs register themselves through custom actions in the 64-bit DLL (src\msi.cpp), the same code regsvr32 uses.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Saitek Cyborg Force Feedback Driver" Manufacturer="WallyCZ" Version="$(Version)"
           UpgradeCode="{307E56EA-9DF9-4F47-882C-C794C13D2E57}" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/WallyCZ/saitek-cyborg-ff" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <!-- Choices in the setup dialog; also the defaults for a silent installation -->
    <Property Id="REMOVESAITEKDRIVER" Value="1" />
    <Property Id="RENAMEDEVICE" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SaitekFF">
        <Directory Id="X64FOLDER" Name="x64">
          <Component Id="DriverX64" Bitness="always64">
            <File Id="SaitekFF64" Source="$(BinDir)\x64\SaitekFF.dll" KeyPath="yes" />
          </Component>
        </Directory>
        <Directory Id="X86FOLDER" Name="x86">
          <Component Id="DriverX86" Bitness="always32">
            <File Id="SaitekFF32" Source="$(BinDir)\x86\SaitekFF.dll" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Driver">
      <ComponentRef Id="DriverX64" />
      <ComponentRef Id="DriverX86" />
    </Feature>

    <!-- Detection runs from a copy of the DLL in the package, before anything is installed -->
    <Binary Id="SetupDll" SourceFile="$(BinDir)\x64\SaitekFF.dll" />
    <CustomAction Id="SaitekDetectDriver" BinaryRef="SetupDll" DllEntry="MsiDetectSaitekDriver" Execute="immediate" Return="ignore" />

    <!-- Registration runs from the installed 64-bit DLL; deferred actions get their input in CustomActionData -->
    <SetProperty Id="SaitekRegisterMachine" Value="[REMOVESAITEKDRIVER]" Before="SaitekRegisterMachine" Sequence="execute" />
    <CustomAction Id="SaitekRegisterMachine" FileRef="SaitekFF64" DllEntry="MsiRegisterMachine" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="SaitekRollbackRegisterMachine" FileRef="SaitekFF64" DllEntry="MsiUnregisterMachine" Execute="rollback" Impersonate="no" Return="ignore" />
    <SetProperty Id="SaitekRegisterUser" Value="[RENAMEDEVICE]" Before="SaitekRegisterUser" Sequence="execute" />
    <CustomAction Id="SaitekRegisterUser" FileRef="SaitekFF64" DllEntry="MsiRegisterUser" Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="SaitekRollbackRegisterUser" FileRef="SaitekFF64" DllEntry="MsiUnregisterUser" Execute="rollback" Impersonate="yes" Return="ignore" />
    <CustomAction Id="SaitekUnregisterUser" FileRef="SaitekFF64" DllEntry="MsiUnregisterUser" Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="SaitekUnregisterMachine" FileRef="SaitekFF64" DllEntry="MsiUnregisterMachine" Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallUISequence>
      <Custom Action="SaitekDetectDriver" Before="CostInitialize" Condition="NOT Installed" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="SaitekUnregisterUser" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="SaitekUnregisterMachine" After="SaitekUnregisterUser" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="SaitekRollbackRegisterMachine" After="InstallFiles" Condition="NOT REMOVE=&quot;ALL&quot;" />
      <Custom Action="SaitekRegisterMachine" After="SaitekRollbackRegisterMachine" Condition="NOT REMOVE=&quot;ALL&quot;" />
      <Custom Action="SaitekRollbackRegisterUser" After="SaitekRegisterMachine" Condition="NOT REMOVE=&quot;ALL&quot;" />
      <Custom Action="SaitekRegisterUser" After="SaitekRollbackRegisterUser" Condition="NOT REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <UI Id="SetupUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="Minimal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <!-- The only dialog of a new installation: what it does and the two choices -->
      <Dialog Id="SetupDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.WelcomeDlgBitmap)" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="40" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Bigger}Saitek Cyborg Force Feedback Driver" />
        <Control Id="Description" Type="Text" X="135" Y="65" Width="220" Height="60" Transparent="yes" NoPrefix="yes"
                 Text="Force feedback for the Saitek Cyborg Evo Force on Windows 10 and 11, for 64-bit and 32-bit games. Settings are in the Game Controllers panel (joy.cpl), on the stick's Force Feedback tab." />
        <Control Id="RemoveOld" Type="CheckBox" X="135" Y="130" Width="220" Height="30" Property="REMOVESAITEKDRIVER" CheckBoxValue="1"
                 Hidden="yes" ShowCondition="SAITEKDRIVERFOUND"
                 Text="Remove the original Saitek driver. It is installed, and this driver cannot work while it is." />
        <Control Id="Rename" Type="CheckBox" X="135" Y="170" Width="220" Height="30" Property="RENAMEDEVICE" CheckBoxValue="1"
                 Text="Rename the stick, for games like DCS that block it because the original driver crashed them." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Install" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" ElevationShield="yes" Text="&amp;Install">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" />

      <InstallUISequence>
        <Show Dialog="SetupDlg" Before="ProgressDlg" Condition="NOT Installed" />
      </InstallUISequence>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Package>
</Wix>
